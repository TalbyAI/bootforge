{
  "name": "bootforge",
  "version": "0.1.0",
  "description": "CLI for applying reusable project setup modules across .NET and TypeScript repositories.",
  "type": "module",
  "bin": {
    "bootforge": "./dist/cli.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/cli.ts",
    "start": "node ./dist/cli.js",
    "test": "vitest run"
  },
  "dependencies": {
    "commander": "^14.0.0",
    "enquirer": "^2.4.1",
    "zod": "^3.24.3"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "tsup": "^8.5.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^3.1.2"
  }
}