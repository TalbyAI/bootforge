{
  "name": "@talby/bootforge",
  "version": "0.1.1",
  "description": "CLI for applying reusable project setup modules across .NET and TypeScript repositories.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TalbyAI/bootforge.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "bootforge": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsx src/cli.ts",
    "smoke": "node dist/cli.js doctor --target tests/fixtures/mixed --json",
    "start": "node ./dist/cli.js",
    "test": "vitest run"
  },
  "dependencies": {
    "commander": "^14.0.0",
    "enquirer": "^2.4.1",
    "zod": "^3.24.3"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "tsdown": "^0.21.10",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^3.1.2"
  }
}
